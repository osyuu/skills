# arch-guard config — declares the dependency layering this repo enforces.
# Sourced by hooks/arch-guard-check.sh. Rule: a file in a layer may import
# ONLY layers below it (later in LAYERS). Upward imports, and — for PARTITIONED
# layers — imports between sibling sub-modules, are flagged. Edit to fit.

# Source root that holds the layer directories.
ROOT="<TODO-source-root>"

# Package/module name as it appears in import strings.
PACKAGE="<TODO-package-name>"

# How an import line references a layer. {LAYER} is substituted per layer; the
# pattern MUST close the layer name with a boundary (so layer "data" doesn't
# match "database"): Dart/TS use the path slash, Python uses a char class —
# a bare `\.` tail silently misses `from <pkg>.<layer> import x`, the most
# common Python form (audit prints 0, indistinguishable from clean).
#   Dart   : import 'package:<pkg>/{LAYER}/       (add (/|\.dart) to also catch barrel files)
#   TS/JS  : from ['"](@/|\.\.?/)([^'"]*/)?{LAYER}(/|['"])
#            anchor to your alias/relative prefix — a bare .*/{LAYER} also hits
#            third-party subpaths ('@angular/core', 'lodash/core') = false positives
#   Python : ^(from|import) <pkg>\.{LAYER}([^A-Za-z0-9_]|$)
IMPORT_RE="<TODO-import-regex>"

# Layers TOP → BOTTOM. Higher may import lower; never the reverse. Each name is
# a directory under ROOT. (blue_book reference: features shared data core)
LAYERS="<TODO-top> ... <TODO-bottom>"

# Layers split into sibling modules that must NOT import each other — e.g. a
# feature-first "features" layer where features/a must not import features/b.
# Space-separated; empty if none.
PARTITIONED="<TODO-e.g. features>"

# grep -v pattern for generated/ignored files (basic regex, \| to alternate).
# 產生檔的 pattern。**basic regex**(上一行說的 `\|` 分隔),例:Dart `\.g\.dart\|\.freezed`、TS `\.generated\.ts`、
# Python `_pb2\.py`。留 <TODO> 的話 checker 會拒跑。
IGNORE="<TODO-generated-file-pattern>"

# ── 必經點規則（選用，留空就不啟用）──────────────────────────────────
# 分層守的是**方向**；這裡守的是「這條路必須經過某個閘」——方向合法、卻繞過了
# 指定入口的呼叫，上面的規則抓不到（`presentation` 直呼 `core` 是往下，合法）。
#
# 一行一條，欄位用 ::: 分隔：
#   <mode>:::<grep -E pattern>:::<給人看的說明>[:::<允許出現的路徑 regex>]
#
# **分隔符不是 `|`**：那是 ERE 的 alternation，`(A|B)` 會被切成兩半而且不報錯。
# **allow 放最後且可省**，省了就是少一個欄位——不會出現連續分隔符那種沒人打得對的寫法。
# pattern 只用 **POSIX ERE**：`\d` `\b` `\s` `\w` 這族在 grep -E 與 awk 之間的支援不一致，
# 而且不合則**靜默回 0 筆**——那跟「這條規則很乾淨」長得一樣。要數字寫 `[0-9]`、
# 要詞邊界寫 `(^|[^A-Za-z0-9_])`（漏了 `0-9` 的話 `1word` 會被誤中）。pattern 也**別以 `:` 結尾**（會與分隔符黏成四個冒號、
# 靜默截斷且不觸發欄位警告）。
#
# mode 由**現況**決定，不是偏好——先 `--audit` 看那條規則現在幾筆：
#   all — 整棵工作樹都不准出現。用在**現在是 0 筆**的規則，鎖住它別退化。
#   new — 只看這次 staged 的新增行。用在**已有存量債**的規則；整樹掃會每次噴
#         幾十行，噴幾次就沒人看了，那等於沒有守門。
#
# 例（同一份 CLAUDE.md 裡的兩條規則，現況不同、模式就不同）：
# CHOKEPOINTS="
# all:::DioException:::業務層只面向 AppException，dio 例外不得外洩:::^lib/core/network/
# new:::extends (StateNotifier|ChangeNotifier):::不要再新增，存量只維護
# "
CHOKEPOINTS=""
